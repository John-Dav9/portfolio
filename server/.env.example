# Copy to server/.env on the VPS (never commit it).

# Public site origin: only this origin may send forms and admin requests.
SITE_ORIGIN=https://john-d.dev

# Admin login. Generate the hash with:
#   docker compose -p portfolio_jd run --rm api node scripts/hash-password.js "votre mot de passe"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# E-mail notifications (new message / new review) through your own mailbox.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your address,
# SMTP_PASS=an app password (Google account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
